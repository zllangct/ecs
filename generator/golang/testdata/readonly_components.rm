rockmem components @package("components") @component();

// State 枚举 - 用于枚举字段 getter 验证
enum State uint8 {
    Idle = 0;
    Running = 1;
}

// Vec3 嵌套 inline 结构体
struct Vec3 inline {
    x float32;
    y float32;
    z float32;
}

// Transform 含嵌套 struct 字段
struct Transform inline {
    pos Vec3;
    rot Vec3;
    scale float32;
}

// Inventory 含基础类型定长数组
struct Inventory inline {
    items [8]int32;
    count int32;
}

// Path 含 struct 定长数组
struct Path inline {
    points [4]Vec3;
    len int32;
}

// AI 含枚举字段
struct AI inline {
    state State;
    target_id int64;
}

// Player 含 @string() 字节数组
struct Player inline {
    name [32]byte @string();
    level int32;
}
